import kaggle


# Download dataset using kaggle api.
get_ipython().getoutput("kaggle datasets download ankitbansal06/retail-orders -f orders.csv")


# Extract file from zip file.
import zipfile
zip_ref = zipfile.ZipFile('retail-orders.zip')
zip_ref.extractall() # Extract file to dir.
zip_ref.close() # Close zip file


import pandas as pd
df = pd.read_csv('orders.csv')
df.head()


for col in df.columns:
    print(f"All distinct values in {col}: \n {df[col].unique()}")
    print("------------------------------------------------------------------------------------------------------------------")





import numpy as np
df['Ship Mode'].replace(['Not Available', 'unknown'], np.nan, inplace = True)


df['Ship Mode'].unique()


# Changing column names to lower-case making them uniform and remove the 'space' with '_'.
df.columns = df.columns.str.lower()
df.columns = df.columns.str.replace(' ','_')


df['ship_mode'].unique()


df.head()


# Derive discount, sale_price and profit fields.
df['discount'] = df['list_price']*df['discount_percent']/100
df['sale_price'] = df['list_price'] - df['discount']
df['profit'] = df['sale_price'] - df['cost_price']


# Dropping columns list_percent, discount_percent, cost_price.
df.drop(columns = ['cost_price', 'list_price', 'discount_percent'], inplace = True)



df.head()


df.dtypes





# Changing the data type of order_date from object to datetime.
df['order_date'] = pd.to_datetime(df['order_date'],format = "%Y-%m-%d")


df.dtypes


